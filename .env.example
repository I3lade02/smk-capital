# VITE_CONTACT_FORM_ENDPOINT=https://smkcapital.cz/contact.php
# VITE_CAR_INSURANCE_ENDPOINT=https://smkcapital.cz/car-insurance.php
# VITE_CONTRACT_REVIEW_ENDPOINT=https://smkcapital.cz/contract-review.php
VITE_MORTGAGE_CALCULATION_ENDPOINT=https://smkcapital.cz/mortgage-calculation.php
