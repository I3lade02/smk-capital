# Same-host production setup, for example when contact.php is next to index.html:
# VITE_CONTACT_FORM_ENDPOINT=contact.php
# VITE_CAR_INSURANCE_ENDPOINT=car-insurance.php
# VITE_MORTGAGE_CALCULATION_ENDPOINT=mortgage-calculation.php
# VITE_CONTRACT_REVIEW_ENDPOINT=contract-review.php

